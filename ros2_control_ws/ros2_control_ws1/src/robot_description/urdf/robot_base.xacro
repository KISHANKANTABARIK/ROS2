<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="length" value="0.5" />
    <xacro:property name="width" value="0.35" />
    <xacro:property name="height" value="0.2" />

    <xacro:property name="mass" value="5.0" />

    <xacro:property name="wheel_mass" value="1.0" />

    <xacro:property name="wheel_radius" value="0.1" />
    <xacro:property name="wheel_width" value="0.05" />
    <xacro:property name="caster_wheel_radius" value="0.05" />

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${length} ${width} ${height}" />
            </geometry>
            <origin xyz="0.0 0.0 ${height/2}" rpy="0.0 0.0 0.0" />
            <material name="red" />
        </visual>
        <xacro:box_inertia m="${mass}" x="${length}" y="${width}" z="${height}"
            o_xyz="0.0 0.0 ${height/2}" o_rpy="0.0 0.0 0.0" />
        <collision>
            <geometry>
                <box size="${length} ${width} ${height}" />
            </geometry>
            <origin xyz="0.0 0.0 ${height/2}" rpy="0.0 0.0 0.0" />
        </collision>
    </link>

    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 0.0" />
            <material name="grey" />
        </visual>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}"
            o_xyz="0.0 0.0 0.0" o_rpy="${pi/2} 0.0 0.0" />
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 0.0" />
        </collision>
    </link>

    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 0.0" />
            <material name="grey" />
        </visual>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}"
            o_xyz="0.0 0.0 0.0" o_rpy="${pi/2} 0.0 0.0" />
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 0.0" />
        </collision>
    </link>
    <link name="caster_wheel_link_front">
        <visual>
            <geometry>
                <sphere radius="${caster_wheel_radius}" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <material name="grey" />
        </visual>
        <xacro:sphere_inertia m="0.5" r="${caster_wheel_radius}" o_xyz="0.0 0.0 0.0"
            o_rpy="0.0 0.0 0.0" />
        <collision>
            <geometry>
                <sphere radius="${caster_wheel_radius}" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <material name="grey" />
        </collision>
    </link>

    <link name="caster_wheel_link_back">
        <visual>
            <geometry>
                <sphere radius="${caster_wheel_radius}" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <material name="grey" />
        </visual>
        <xacro:sphere_inertia m="0.5" r="${caster_wheel_radius}" o_xyz="0.0 0.0 0.0"
            o_rpy="0.0 0.0 0.0" />
        <collision>
            <geometry>
                <sphere radius="${caster_wheel_radius}" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <material name="grey" />
        </collision>
    </link>

    <link name="base_footprint"></link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0.0 0.0 ${height/2}" rpy="0.0 0.0 0.0" />
    </joint>

    <!-- Left wheel joint - centered at robot length axis for better kinematics -->
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel" />
        <origin xyz="0.0 ${(width/2) + (wheel_width/2)} 0.0" rpy="0.0 0.0 0.0" />
        <axis xyz="0.0 1.0 0.0" />
    </joint>

    <!-- Right wheel joint - centered at robot length axis for better kinematics -->
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel" />
        <origin xyz="0.0 ${-((width/2) + (wheel_width/2))} 0.0" rpy="0.0 0.0 0.0" />
        <axis xyz="0.0 1.0 0.0" />
    </joint>

    <!-- Front caster wheel joint -->
    <joint name="caster_wheel_joint_front" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_link_front" />
        <origin xyz="${(length/2) - 0.05} 0.0 ${-(caster_wheel_radius)}" rpy="0.0 0.0 0.0" />
    </joint>

    <!-- Back caster wheel joint -->
    <joint name="caster_wheel_joint_back" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_link_back" />
        <origin xyz="${-(length/2) + 0.05} 0.0 ${-(caster_wheel_radius)}" rpy="0.0 0.0 0.0" />
    </joint>

    <!-- Gazebo plugins and materials -->
    <gazebo reference="base_link">
        <material>Gazebo/Red</material>
    </gazebo>



</robot>